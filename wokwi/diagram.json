    [ "dht:GND", "esp:GND.1", "black", [] ],
    [ "dht:SDA", "esp:15", "green", [] ],
    [ "ldr:VCC", "esp:3V3", "red", [] ],
    [ "ldr:GND", "esp:GND.1", "black", [] ],
    [ "ldr:AO", "esp:34", "purple", [] ],
    [ "mq2:VCC", "esp:3V3", "red", [] ],
    [ "mq2:GND", "esp:GND.1", "black", [] ],
    [ "mq2:AOUT", "esp:35", "gold", [] ],
    [ "btn:1.l", "esp:4", "cyan", [] ],
    [ "btn:2.l", "esp:GND.2", "black", [] ]
