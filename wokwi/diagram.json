      "attrs": { "temperature": "22.5", "humidity": "50" }
    },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr", "top": 220, "left": -250, "attrs": {} },
    { "type": "wokwi-gas-sensor", "id": "mq2", "top": 300, "left": -250, "attrs": {} },
