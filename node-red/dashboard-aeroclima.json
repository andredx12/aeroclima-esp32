  {
    "id": "aero_fn_prev",
    "type": "function",
    "z": "340416837c6d3335",
    "name": "Separar previsão",
    "func": "const p = msg.payload;\nif (!p) return null;\n\nconst previsao = { payload: p.previsao };\nconst pressao = { payload: p.pressao !== null ? p.pressao + \" hPa\" : \"Aguardando API\" };\nconst tendencia = { payload: p.tendencia_texto + \" (\" + p.tendencia + \" hPa)\" };\n\nlet externo = p.clima_api || \"Sem dados\";\nif (p.temp_externa !== null && p.temp_externa !== undefined) {\n    externo += \" | \" + p.temp_externa + \" °C\";\n}\nconst api = { payload: externo };\n\nreturn [previsao, pressao, tendencia, api];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 570,
    "y": 580,
