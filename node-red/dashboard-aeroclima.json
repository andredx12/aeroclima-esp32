  {
    "id": "aero_fn_dados",
    "type": "function",
    "z": "340416837c6d3335",
    "name": "Separar dados",
    "func": "const d = msg.payload;\nif (!d) return null;\n\nconst temp = { payload: d.temp };\nconst umid = { payload: d.umid };\nconst conforto = { payload: d.idt + \" (\" + d.conforto + \")\" };\nconst gas = { payload: d.gas };\nconst ar = { payload: d.qualidade };\nconst luz = { payload: d.lux + \" lux (\" + d.nivel_luz + \")\" };\nconst grafico = [\n    { topic: \"Temperatura (°C)\", payload: d.temp },\n    { topic: \"Umidade (%)\", payload: d.umid }\n];\nconst alertas = {\n    payload: (d.alertas && d.alertas.length)\n        ? \"⚠️ \" + d.alertas.join(\" | \")\n        : \"✅ Nenhum alerta\"\n};\n\nreturn [temp, umid, conforto, gas, ar, luz, grafico, alertas];",
    "outputs": 8,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 280,
    "wires": [
      [
        "aero_gauge_temp"
      ],
      [
        "aero_gauge_umid"
      ],
      [
